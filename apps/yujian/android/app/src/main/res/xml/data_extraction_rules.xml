<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+：云备份和设备间迁移都排除全部数据（账本 / 设置 / 密钥只留在这台手机，换机走 App 内导出）。 -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
